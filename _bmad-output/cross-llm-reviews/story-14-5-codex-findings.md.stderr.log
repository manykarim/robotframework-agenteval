    39	
    40	def _normalize_keyword_args(
    41	    keyword_args: dict[str, Any] | list[Any] | None,
    42	) -> tuple[list[Any], dict[str, Any]]:
    43	    """Normalize RF-flexible `keyword_args` into `(positional, kwargs)`.
    44	
    45	    Story 6.3 code-review HIGH-β fix (Codex + Blind + Edge 3-way): pre-edit
    46	    rewrote positional values into synthetic `_arg_0`/`_arg_1` kwargs which
    47	    crashed `keyword_callable(_arg_0=...)` with `TypeError: unexpected
    48	    keyword argument '_arg_0'`. Now returns positional + kwargs separately
    49	    so dispatch can use `keyword_callable(*positional, **kwargs)`.
    50	
    51	    Accepts:
    52	    - `None` → `([], {})`
    53	    - `dict` → `([], copy)` — all named.
    54	    - `list[Any]` → walks each item:
    55	      - `str` containing `"="` (RF named-arg form `"key=value"`) → split into
    56	        kwargs (key + value both `.strip()`-ed per HIGH-τ fix).
    57	      - Any other item → preserved as positional.
    58	
    59	    Per epic L1642 form `keyword_args=[adapter=generic, prompt=Hello]` is RF's
    60	    named-kwarg list-of-strings syntax — `"adapter=generic"` is a single string.
    61	    """
    62	    if keyword_args is None:
    63	        return ([], {})
    64	    if isinstance(keyword_args, dict):
    65	        return ([], dict(keyword_args))
    66	    if isinstance(keyword_args, list):
    67	        positional: list[Any] = []
    68	        named: dict[str, Any] = {}
    69	        for item in keyword_args:
    70	            if isinstance(item, str) and "=" in item:
    71	                # RF named-arg form: "key=value" — strip both sides per
    72	                # Story 6.3 code-review HIGH-τ fix (Edge 1-way): RF
    73	                # indented kwargs preserve trailing whitespace on values.
    74	                key, _, value = item.partition("=")
    75	                named[key.strip()] = value.strip()
    76	            else:
    77	                positional.append(item)
    78	        return (positional, named)
    79	    raise TypeError(f"keyword_args must be dict, list, or None; got type {type(keyword_args).__name__}")
