   149	    # ACTUALLY saw (caller's explicit `seed=` in named-kwargs wins over our
   150	    # injected `effective_seed`) — preserves reproducibility contract.
   151	    raw_seed: Any = call_kwargs.get("seed", effective_seed)
   152	    recorded_seed: int | None
   153	    if raw_seed is None:
   154	        recorded_seed = None
   155	    elif isinstance(raw_seed, int) and not isinstance(raw_seed, bool):
   156	        recorded_seed = raw_seed
   157	    else:
   158	        # Non-int seed (e.g., string from RF positional list) — best-effort int coercion.
   159	        try:
   160	            recorded_seed = int(raw_seed)
   161	        except (ValueError, TypeError):
   162	            recorded_seed = None
   163	
   164	    return KeywordRun(
   165	        trial_index=trial_index,
   166	        test_id=test_id,
   167	        keyword_name=keyword_name,
   168	        result=result,
   169	        error=None,
   170	        completeness=completeness,
   171	        latency_seconds=latency_seconds,
   172	        seed=recorded_seed,
   173	    )
