    15	"""Tier annotation mechanism per architecture L620 + Decision-1.
    16	
    17	Every public keyword in `src/AgentEval/*/library.py` is annotated with
    18	`@tier(N)` where N is 1, 2, or 3:
    19	
    20	- **Tier 1 — Deterministic.** Static-inspection, ACL-gated determinism is
    21	  enforced by the conformance suite; e.g., `Skill Get Description`.
    22	- **Tier 2 — Stochastic Single-Shot.** Single LLM round-trip per keyword
    23	  invocation; e.g., `Agent Run`.
    24	- **Tier 3 — Stochastic Fan-Out.** Multi-trial fan-out via the
    25	  `@guarded_fanout` decorator (ADR-015); e.g., `Stat Run N Times`.
    26	
    27	The `_agenteval_tier` attribute (single-underscore convention per architecture
    28	L620, NOT `__agenteval_tier__` dunder) is attached to the decorated function.
    29	Story 1b.6's convention enforcer asserts every `@keyword`-decorated method has
    30	a `@tier()` annotation; missing annotation raises `KeywordTierMissingError`
    31	at library import.
    32	"""
    33	
    34	from __future__ import annotations
    35	
    36	from collections.abc import Callable
    37	from typing import Any, Literal, TypeVar
    38	
    39	F = TypeVar("F", bound=Callable[..., object])
    40	
    41	__all__ = ["tier", "get_keyword_tier", "tier_badge", "find_tier_through_wrappers"]
    42	
    43	
    44	def find_tier_through_wrappers(func: Any) -> int | None:
    45	    """Walk `__wrapped__` chain (functools.wraps) checking for `_agenteval_tier`.
    46	
    47	    Story 6.3 code-review HIGH-δ fix (Codex + Blind + Auditor 3-way): when a
    48	    `@tier(N)` decorator is composed with another decorator that uses
    49	    `functools.wraps` (e.g., `@guarded_fanout`), the tier attribute can land
    50	    on EITHER the outer wrapper OR the inner function depending on decorator
    51	    application order. This helper checks every level of the chain (outer →
    52	    inner) and returns the first integer `_agenteval_tier` found, or `None`.
    53	
    54	    Returns `None` for unannotated functions.
    55	    """
    56	    seen: set[int] = set()
    57	    current = func
    58	    for _ in range(20):  # bounded loop to avoid pathological cycles
    59	        if id(current) in seen:
    60	            return None
    61	        seen.add(id(current))
    62	        value = getattr(current, "_agenteval_tier", None)
    63	        if isinstance(value, int):
    64	            return value
    65	        wrapped = getattr(current, "__wrapped__", None)
    66	        if wrapped is None or wrapped is current:
    67	            return None
    68	        current = wrapped
    69	    return None
    70	
    71	
    72	_TIER_BADGES: dict[int, str] = {
    73	    1: "[Tier 1 — Deterministic]",
    74	    2: "[Tier 2 — Stochastic Single-Shot]",
    75	    3: "[Tier 3 — Stochastic Fan-Out]",
    76	}
    77	
    78	
    79	def tier(n: Literal[1, 2, 3]) -> Callable[[F], F]:
    80	    """Tier-annotation decorator factory.
    81	
    82	    Args:
    83	        n: Tier level — 1 (deterministic), 2 (stochastic single-shot),
    84	            or 3 (stochastic fan-out).
    85	
    86	    Returns:
    87	        A decorator that attaches `_agenteval_tier = n` to the wrapped
    88	        function and returns the function unchanged.
    89	
    90	    Raises:
    91	        ValueError: If `n` is not 1, 2, or 3. Raised at decoration time.
    92	    """
    93	    # L1 review fix: bool is a subclass of int, so `True in (1, 2, 3)` is True
    94	    # (since True == 1). Reject bool explicitly to avoid `@tier(True)` silently
    95	    # acting as `@tier(1)`. The `isinstance(n, bool)` check is reachable at
    96	    # runtime even though the Literal[1, 2, 3] annotation makes mypy think it
    97	    # isn't — callers can (and have, in the wild) pass True/False with type:
    98	    # ignore, and we want a loud failure rather than silent miscategorization.
    99	    if isinstance(n, bool) or n not in (1, 2, 3):
   100	        raise ValueError("tier must be 1, 2, or 3")
   101	
   102	    def _decorate(func: F) -> F:
   103	        func._agenteval_tier = n  # type: ignore[attr-defined]
   104	        return func
   105	
   106	    return _decorate
   107	
   108	
   109	def get_keyword_tier(func: Callable[..., object]) -> int | None:
   110	    """Return the tier of a `@tier`-annotated function, or None if unannotated."""
   111	    return getattr(func, "_agenteval_tier", None)
   112	
   113	
   114	def tier_badge(tier_level: int) -> str:
   115	    """Return the libdoc badge text for a tier level.
   116	
   117	    Args:
   118	        tier_level: 1, 2, or 3.
   119	
   120	    Returns:
   121	        Exact badge string (one of "[Tier 1 — Deterministic]",
   122	        "[Tier 2 — Stochastic Single-Shot]", "[Tier 3 — Stochastic Fan-Out]").
   123	
   124	    Raises:
   125	        ValueError: If `tier_level` is not 1, 2, or 3.
   126	    """
   127	    try:
   128	        return _TIER_BADGES[tier_level]
   129	    except KeyError as exc:
   130	        raise ValueError("tier must be 1, 2, or 3") from exc

