    15	"""Recipe CI extraction harness (Story 14.3 deliverable).
    16	
    17	Walks every ``docs/recipes/*.md`` file, extracts every fenced
    18	` ```robotframework ` block, classifies each, and runs ``robot --dryrun``
    19	against each dryrun-eligible block (blocks containing ``*** Test Cases ***``).
    20	
    21	Closes 3 retro action items (3 epics carryover chain) + 1 catalog row:
    22	- Epic 11 retro Action #7 (2026-05-27, original).
    23	- Epic 12 retro Action #9 (2026-06-01, carried).
    24	- Epic 13 retro Action #9 (2026-06-03, carried again).
    25	- C64 / DF-8b.3-S1 (catalog row at ``docs/phase-1-5-carry-overs.md`` L91).
    26	
    27	Block classification (per Story 14.3 D-1):
    28	- ``dryrun_eligible``: contains ``*** Test Cases ***``. Wrapped with
    29	  ``*** Settings ***\\nLibrary    AgentEval\\n\\n`` if no settings header
    30	  is present, then dryrun'd.
    31	- ``settings_only``: contains ``*** Settings ***`` only (no test cases —
    32	  recipe-8 OTLP config examples). SKIPPED with ``pytest.skip(reason=...)``.
    33	- ``fragment``: no section headers (standalone keyword calls referencing
    34	  variables defined earlier in the recipe prose — recipe-2 / recipe-3 /
    35	  recipe-7 inline snippets). SKIPPED with ``pytest.skip(reason=...)``.
    36	
    37	Intentional overlap with ``tests/integration/recipes/test_pass_at_k_recipe.py``
    38	per AC-14.3.4: Recipe #2's block-0 (the full suite) is now exercised by both
    39	tests. The Phase-1 representative is retained as redundant coverage; removal
    40	would shrink the test surface.
    41	
    42	Story 14.2's catalog-gate hook scans staged diffs for ``DF-X.Y-SZ`` references.
    43	This file does NOT contain any ``DF-`` reference in test fixtures (the
    44	broken-block fixture uses ``Get From Dictionary``, which is NOT a DF ref).
    45	The harness only walks ``docs/recipes/*.md`` — never ``tests/`` — so no
    46	self-recursion concern.
    47	"""
    48	
    49	from __future__ import annotations
    50	
    51	import importlib.util
    52	import re
    53	import subprocess
    54	import sys
    55	from dataclasses import dataclass
    56	from pathlib import Path
    57	
    58	import pytest
    59	
    60	REPO_ROOT = Path(__file__).resolve().parents[3]
    61	RECIPES_DIR = REPO_ROOT / "docs" / "recipes"
    62	ROBOTFRAMEWORK_FENCE_OPEN = "```robotframework"
    63	ROBOTFRAMEWORK_FENCE_CLOSE = "```"
    64	
    65	_TEST_CASES_RE = re.compile(r"^\*\*\* Test Cases \*\*\*\s*$", re.MULTILINE)
    66	_SETTINGS_RE = re.compile(r"^\*\*\* Settings \*\*\*\s*$", re.MULTILINE)
    67	
    68	
    69	@dataclass(frozen=True)
    70	class FencedRobotBlock:
    71	    """A fenced ``robotframework`` code block extracted from a recipe markdown file."""
    72	
    73	    recipe: str  # Basename of the source `.md` (e.g., "02-pass-at-k-over-polling.md").
    74	    block_index: int  # 0-based ordinal within the recipe.
    75	    raw: str  # Block content without the fence markers (trailing newline preserved).
    76	    source_line: int  # 1-based line in source `.md` where the opening fence sits.
    77	
    78	    @property
    79	    def test_id(self) -> str:
    80	        return f"{self.recipe}::block-{self.block_index}"
    81	
    82	
    83	_ROBOT_FENCE_OPEN_RE = re.compile(r"^(?P<fence>`{3,})robotframework\s*$")
    84	
    85	
    86	def extract_robotframework_blocks(path: Path) -> list[FencedRobotBlock]:
    87	    """Walk ``path`` line-by-line and return every fenced ``robotframework`` block.
    88	
    89	    Closes on a bare fence of the SAME LENGTH as the opener (per CommonMark
    90	    GFM fenced-code-block semantics). This handles nested fenced examples
    91	    inside a robot block — e.g., an inner ```` ```python ```` example
    92	    with shorter or differently-tagged fence is preserved verbatim rather
    93	    than truncating the outer block (per Story 14.3 Codex HIGH-A).
    94	
    95	    Handles edge cases:
    96	    - Empty blocks (raw="") are returned (caller may classify them).
    97	    - Unclosed blocks raise ``ValueError``.
    98	    """
    99	    text = path.read_text(encoding="utf-8")
   100	    blocks: list[FencedRobotBlock] = []
   101	    in_block = False
   102	    block_lines: list[str] = []
   103	    open_line: int = 0
   104	    block_index = 0
   105	    open_fence: str = ""
   106	    for lineno, line in enumerate(text.splitlines(), start=1):
   107	        if not in_block:
   108	            m = _ROBOT_FENCE_OPEN_RE.match(line)
   109	            if m:
   110	                in_block = True
   111	                block_lines = []
   112	                open_line = lineno
   113	                open_fence = m.group("fence")
   114	            continue
   115	        # in_block == True — close only on a bare fence matching the opener's length.
   116	        stripped = line.rstrip()
   117	        if stripped == open_fence:
   118	            raw = "\n".join(block_lines)
   119	            if block_lines:
   120	                raw += "\n"
   121	            blocks.append(
   122	                FencedRobotBlock(
   123	                    recipe=path.name,
   124	                    block_index=block_index,
   125	                    raw=raw,
   126	                    source_line=open_line,
   127	                )
   128	            )
   129	            block_index += 1
   130	            in_block = False
   131	            block_lines = []
   132	            open_fence = ""
   133	            continue
   134	        block_lines.append(line)
   135	    if in_block:
   136	        raise ValueError(
   137	            f"Unclosed ```robotframework block in {path} starting at line {open_line}"
   138	        )
   139	    return blocks
   140	
   141	
   142	def classify_block(block: FencedRobotBlock) -> str:
   143	    """Return one of ``"dryrun_eligible"``, ``"settings_only"``, or ``"fragment"``.
   144	
   145	    - ``dryrun_eligible``: block contains ``*** Test Cases ***`` (whether or
   146	      not ``*** Settings ***`` is also present).
   147	    - ``settings_only``: block contains ``*** Settings ***`` only.
   148	    - ``fragment``: block contains neither section header.
   149	    """
   150	    has_test_cases = bool(_TEST_CASES_RE.search(block.raw))
   151	    has_settings = bool(_SETTINGS_RE.search(block.raw))
   152	    if has_test_cases:
   153	        return "dryrun_eligible"
   154	    if has_settings:
   155	        return "settings_only"
   156	    return "fragment"
   157	
   158	
   159	def wrap_block_for_dryrun(block: FencedRobotBlock) -> str:
   160	    """Return the full RF suite text to write to a temp ``.robot`` file.
   161	
   162	    - If block has ``*** Settings ***``: returns ``block.raw`` unchanged.
   163	    - If block has ``*** Test Cases ***`` but NOT ``*** Settings ***``:
   164	      prepends a minimal Library import block.
   165	    - Settings-only or fragment blocks are NOT wrappable (they are SKIPPED
   166	      upstream); raises ``ValueError`` on those classes for safety.
   167	    """
   168	    has_test_cases = bool(_TEST_CASES_RE.search(block.raw))
   169	    has_settings = bool(_SETTINGS_RE.search(block.raw))
   170	    if not has_test_cases:
   171	        raise ValueError(
   172	            f"Block {block.test_id} is not dryrun-eligible "
   173	            "(no `*** Test Cases ***` header); cannot wrap."
   174	        )
   175	    if has_settings:
   176	        return block.raw
   177	    return f"*** Settings ***\nLibrary    AgentEval\n\n{block.raw}"
   178	
   179	
   180	def _collect_all_blocks() -> list[FencedRobotBlock]:
   181	    """Return every fenced ``robotframework`` block across every recipe `.md` file."""
   182	    out: list[FencedRobotBlock] = []
   183	    for md_path in sorted(RECIPES_DIR.glob("*.md")):
   184	        out.extend(extract_robotframework_blocks(md_path))
   185	    return out
   186	
   187	
   188	def _collect_eligible_blocks() -> list[FencedRobotBlock]:
   189	    return [b for b in _collect_all_blocks() if classify_block(b) == "dryrun_eligible"]
   190	
