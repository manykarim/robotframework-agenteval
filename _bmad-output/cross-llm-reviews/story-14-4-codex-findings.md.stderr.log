    63	    assert result.response_text, "expected non-empty response_text from live SDK"
    64	    assert result.cost_usd >= 0.0, "cost should be reported (may be 0.0 on cached responses)"
    65	    assert result.metadata.mcp_coverage == "hosted_in_process"
    66	    assert result.metadata.completeness == "complete"
    67	    assert result.latency_seconds > 0.0

