+          cache-dependency-glob: "pyproject.toml"
+
+      - name: Set Python version
+        run: echo "3.12" > .python-version
+
+      - name: Install dependencies
+        run: uv sync --all-extras
+
+      - name: Detect adapter binary versions (_TESTED_UP_TO drift evidence)
+        shell: bash
+        run: |
