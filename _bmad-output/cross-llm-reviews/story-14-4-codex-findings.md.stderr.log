    45	)
    46	def test_openai_agents_sdk_single_shot_live() -> None:
    47	    """Single-shot 'say hello' against the real OpenAI Agents SDK.
    48	
    49	    Asserts: response is non-empty AND cost > 0. Does NOT assert on the
    50	    exact response text (model output is non-deterministic).
