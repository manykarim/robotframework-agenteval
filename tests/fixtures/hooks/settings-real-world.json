{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/format-guard.sh",
            "timeout": 30,
            "statusMessage": "formatting...",
            "async": true
          },
          {
            "type": "prompt",
            "prompt": "Confirm this edit is safe.",
            "model": "claude-opus-4-6"
          }
        ]
      },
      {
        "matcher": "mcp__memory__.*",
        "hooks": [
          {
            "type": "http",
            "url": "https://audit.example.com/pre-tool",
            "headers": {"X-Source": "agenteval"},
            "if": "tool_input.contains('secret')"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo session-started",
            "once": true
          }
        ]
      }
    ]
  }
}
