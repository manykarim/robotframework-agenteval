{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo pre-tool-use",
            "args": ["--quiet"],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "echo pre-tool-use-second"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo post-tool-use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo stop",
            "args": []
          }
        ]
      }
    ]
  }
}
