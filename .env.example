# agenteval env vars — copy to .env and customize.
# Naming: AGENTEVAL_<KEY>.
# Precedence: keyword argument > env var > .env file > defaults.
#
# Boolean values accept the case-insensitive set {true, false, 1, 0, yes, no,
# on, off}. Anything else raises an error when the library is constructed.
#
# Quoted values and an optional `export ` prefix are stripped when the .env
# file is loaded. Inline `#` comments after a value are NOT supported (the
# value runs to end-of-line). Unknown AGENTEVAL_* keys emit a warning so
# typos like `AGENTEVAL_PROVDER` surface visibly.

# --- API keys for live models -------------------------------------------------
# The default `litellm` provider reads these from the environment and passes
# them through to the model provider. Uncomment and set the one(s) you use.
# Never commit real keys. See docs/running-against-a-real-model.md for the full
# mock-to-live switch.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- agenteval settings -------------------------------------------------------

# Provider selection (default: litellm). Use `mock` for keyless, deterministic
# tests.
AGENTEVAL_PROVIDER=litellm

# Telemetry (default: true; set false to disable).
AGENTEVAL_TELEMETRY=true

# Trace backend: memory | jsonl (otlp requires the `[otlp]` extra).
AGENTEVAL_TRACE_BACKEND=memory

# MCP per-test scope (default: true). Valid values:
#   true  = per-test isolation (default; correct under parallel execution)
#   suite = per-suite scope (a documented trade-off)
#   false = single shared instance across all tests (only correct when serial)
AGENTEVAL_MCP_PER_TEST=true

# Validate operator gate (default: false; explicit opt-in).
AGENTEVAL_ALLOW_VALIDATE_OPERATOR=false

# Cost guardrail in USD (default: 5.0). Stochastic fan-out keywords stop before
# a test exceeds this.
AGENTEVAL_MAX_COST_USD=5.0

# Default provider temperature (default: 0.0).
AGENTEVAL_DEFAULT_TEMPERATURE=0.0

# Fan-out wall-clock budget in seconds (default: empty = no cap; opt in with a
# value).
AGENTEVAL_MAX_RUNTIME_SECONDS=

# External-MCP coverage gate (default-deny; set true to allow external_mixed runs).
AGENTEVAL_ALLOW_EXTERNAL_MCP_BLIND=false

# OTLP trace backend endpoint (requires the `[otlp]` extra). Only consumed when
# AGENTEVAL_TRACE_BACKEND=otlp. URL scheme selects transport:
#   - http://  / https:// → OTLP HTTP/protobuf exporter (port 4318)
#   - grpc://  / grpcs:// → OTLP gRPC exporter (port 4317)
# Examples:
#   AGENTEVAL_OTLP_ENDPOINT=http://localhost:4318/v1/traces       # local Jaeger HTTP
#   AGENTEVAL_OTLP_ENDPOINT=grpc://localhost:4317                 # local Tempo gRPC (insecure)
#   AGENTEVAL_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces    # Honeycomb HTTPS
# Default (when otlp + this is unset): http://localhost:4318/v1/traces.
AGENTEVAL_OTLP_ENDPOINT=
